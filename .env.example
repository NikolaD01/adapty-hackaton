# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
ADAPTY_APP_ID=c6c7bdd1-1010-4343-8b29-837a77793cab
ADAPTY_SECRET_KEY=
# How the backend runs the Adapty CLI. In docker compose this is forced to "adapty" (installed in the image).
# Running the backend on the host instead: "adapty" if installed globally (npm i -g adapty@0.18.0).
ADAPTY_CLI=adapty
# Offline dataset folder (data/offline of kpotehin/adapty-seed-data-hack)
# Authorization header value configured for the Adapty webhook (Integrations → Webhook); empty = no check
ADAPTY_WEBHOOK_AUTH=
OFFLINE_DATA_DIR=./data/offline
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:5173
