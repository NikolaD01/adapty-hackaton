# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
ADAPTY_APP_ID=c6c7bdd1-1010-4343-8b29-837a77793cab
ADAPTY_SECRET_KEY=
# How to run the Adapty CLI from the backend: "adapty" if installed on the host,
# or through the team's Docker image:
ADAPTY_CLI=docker compose -f ../../docker-compose.yml run --rm -T dev adapty
# Offline dataset folder (data/offline of kpotehin/adapty-seed-data-hack)
OFFLINE_DATA_DIR=./data/offline
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:5173
